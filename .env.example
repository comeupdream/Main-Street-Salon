# ---------------------------------------------------------------------------
# Main Street Salon — environment variables
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# Postgres connection string. Use your host's URL:
#   Render   -> the database's "Internal Database URL"
#   Neon/Supabase -> the connection string they give you (add ?sslmode=require)
#   Local    -> postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Password for the /admin spreadsheet. CHANGE THIS before going live.
ADMIN_PASSWORD="changeme"

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="please-change-me-to-a-long-random-string"
