# ---------------------------------------------------------------------------
# Main Street Salon — environment variables
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# Database connection.
# Local dev default = SQLite file. For production (e.g. Vercel) point this at a
# hosted Postgres URL and change provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Password for the /admin spreadsheet. CHANGE THIS before going live.
ADMIN_PASSWORD="changeme"

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="please-change-me-to-a-long-random-string"
